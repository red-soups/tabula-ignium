{
  "name": "sanbool24",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "main": "./worker.js",
  "vars": {
    "API_ORIGIN": "https://integral-poll-teach-contractor.trycloudflare.com"
  }
}
